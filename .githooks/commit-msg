#!/bin/sh
# Refuses a commit whose subject is not a conventional commit:
#   type(scope)!: description
# The same script gates CI (.github/workflows/commits.yml), so what this
# accepts locally is exactly what a pull request is held to.
#
# Enable it once per clone:  git config core.hooksPath .githooks
set -eu

subject=$(sed -n '1p' "$1")

# A merge in progress is exempt, because git writes its subject. Decided by
# MERGE_HEAD and not by the word "Merge", which an ordinary commit could
# start with to slip past the rule. CI skips merge commits itself and never
# has a merge in progress, so there a "Merge ..." subject is held to the rule.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

# Other subjects git writes itself: nobody typed them, and the commits they
# name are held to the rule on their own.
case "$subject" in
  "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|test|ci|chore|style'
if printf '%s\n' "$subject" | grep -Eq "^($types)(\([^()[:space:]]+\))?!?: [^[:space:]].*$"; then
  exit 0
fi

cat >&2 <<MSG
Not a conventional commit subject:

  $subject

Expected  type(scope)!: description
  type   one of: $(printf '%s' "$types" | sed 's/|/, /g')
  scope  optional, in parentheses
  !      optional, marks a breaking change
MSG
exit 1
